{
  "name": "sprite-editor",
  "version": "0.2.2",
  "private": true,
  "author": "Fablespace",
  "description": "A standalone pixel sprite editor.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win zip dir --x64",
    "test": "node test/pixels.test.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.fablespace.sprite-editor",
    "productName": "Sprite Editor",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "editor/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "executableName": "SpriteEditor",
      "target": [
        { "target": "dir", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "SpriteEditor-${version}-win.${ext}"
    }
  }
}
